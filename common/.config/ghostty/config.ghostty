shell-integration = zsh
shell-integration-features = ssh-terminfo,ssh-env
font-family = Hack Nerd Font
font-size = 20
theme = Gruvbox Dark
mouse-hide-while-typing = true

# 31.25 MB
scrollback-limit = 33554432

window-save-state = always
resize-overlay = never
macos-titlebar-style = tabs
# Let terminal applications handle Control+Tab.
keybind = ctrl+tab=unbind

keybind = alt+t=toggle_quick_terminal

# Adding Command distinguishes Ghostty panes from Neovim's Control shortcuts.
keybind = super+ctrl+h=goto_split:left
keybind = super+ctrl+j=goto_split:bottom
keybind = super+ctrl+k=goto_split:top
keybind = super+ctrl+l=goto_split:right

keybind = super+ctrl+v=new_split:right
keybind = super+ctrl+s=new_split:down

keybind = super+ctrl+u=scroll_page_fractional:-0.5
keybind = super+ctrl+d=scroll_page_fractional:0.5

# Ctrl + [ as Escape
keybind = ctrl+[=text:\x1b
# Ignore Ctrl modifier when pressing enter
keybind = ctrl+enter=text:\r
