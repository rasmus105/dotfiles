#!/usr/bin/env bash
set -euo pipefail

fail() {
    printf 'ai-commit: %s\n' "$*" >&2
    exit 1
}

resolve_script_dir() {
    local source_path="${BASH_SOURCE[0]}"
    local source_dir
    local target

    while [[ -L "$source_path" ]]; do
        source_dir="$(cd -P -- "$(dirname -- "$source_path")" && pwd)"
        target="$(readlink "$source_path")"
        if [[ "$target" = /* ]]; then
            source_path="$target"
        else
            source_path="$source_dir/$target"
        fi
    done

    cd -P -- "$(dirname -- "$source_path")" && pwd
}

backend="${AI_COMMIT_BACKEND:-pi}"
model="${AI_COMMIT_MODEL:-}"

git rev-parse --is-inside-work-tree >/dev/null 2>&1 ||
    fail "not inside a Git working tree"

if [[ -z "$(git status --porcelain --untracked-files=normal)" && "$#" -eq 0 ]]; then
    fail "no changes to commit"
fi

guidance="${*:-No additional guidance.}"
IFS= read -r -d '' opencode_config <<'JSON' || true
{
  "permission": {
    "*": "deny",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "head": "allow",
    "echo": "allow",
    "bash": {
      "*": "deny",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git add *": "allow",
      "git commit -m *": "allow",
      "git commit --amend -m *": "allow",
      "git add *--force*": "deny",
      "git add -f*": "deny",
      "git add * -f*": "deny",
      "git commit *--no-verify*": "deny",
      "git commit -n*": "deny",
      "git commit * -n*": "deny"
    }
  }
}
JSON

IFS= read -r -d '' prompt <<PROMPT || true
Create or amend one Git commit now. This invocation authorizes the commit;
do not ask questions or wait for confirmation.

Requirements:
- Follow explicit additional guidance about commit scope. Otherwise, if anything
  is staged, commit exactly the current index. Leave unstaged and untracked changes
  untouched, including unstaged edits in partially staged files.
- If nothing is staged, stage the current changes and create one commit, limiting
  the selected paths only when additional guidance requests it.
- Treat the selected scope as intentional. Related unstaged code or documentation,
  incomplete work, missing tests, and possible inconsistencies are not reasons to
  refuse, expand the scope, or request confirmation.
- Inspect the status, selected diff, and recent Git history to write the message.
  This is a commit task; do not review, fix files, or run tests yourself.
- Match the repository's commit message convention.
- Prefer a single-line subject with no body unless repository convention or guidance calls for one.
- Amend only when explicitly requested. Otherwise create exactly one new commit.
- Run normal Git hooks.
- Stop only for concrete blockers: suspected credentials, secrets, or sensitive
  data in the selected changes; unresolved merge conflicts; a failing hook or Git
  command; or nothing to commit. Explain the blocker without asking for confirmation.
- After success, report the commit hash and subject concisely.

Additional guidance: $guidance
PROMPT

case "$backend" in
    pi)
        pi_bin="${AI_COMMIT_PI_BIN:-pi}"
        command -v "$pi_bin" >/dev/null 2>&1 ||
            fail "Pi is not installed or not on PATH"
        script_dir="$(resolve_script_dir)"
        pi_extension="${AI_COMMIT_PI_EXTENSION:-$script_dir/../lib/ai-git/pi-git-tools.js}"
        [[ -r "$pi_extension" ]] ||
            fail "Pi Git tools extension not found: $pi_extension"
        run_pi() {
            local auto_exit="$1"
            shift
            AI_GIT_PI_MODE=commit AI_GIT_PI_AUTO_EXIT="$auto_exit" command "$pi_bin" \
                "$@" \
                --no-session \
                --no-extensions \
                --no-skills \
                --no-prompt-templates \
                --no-context-files \
                --no-approve \
                --tools read,grep,find,ls,git_status,git_diff,git_log,git_add,git_commit \
                --extension "$pi_extension" \
                --model "${model:-openai-codex/gpt-6-luna}" \
                "$prompt"
        }
        if [[ ! -t 0 || ! -t 1 ]]; then
            run_pi 0 --print
        else
            run_pi 1
        fi
        ;;
    opencode)
        opencode_bin="${AI_COMMIT_OPENCODE_BIN:-opencode}"
        command -v "$opencode_bin" >/dev/null 2>&1 ||
            fail "OpenCode is not installed or not on PATH"
        OPENCODE_CONFIG_CONTENT="$opencode_config" \
            command "$opencode_bin" run --model "${model:-deepseek/deepseek-v4-flash}" "$prompt"
        ;;
    *)
        fail "unsupported backend: $backend"
        ;;
esac
