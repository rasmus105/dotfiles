#!/usr/bin/env bash
set -euo pipefail

fail() {
    printf 'ai-commit: %s\n' "$*" >&2
    exit 1
}

resolve_script_dir() {
    local source_path="${BASH_SOURCE[0]}"
    local source_dir
    local target

    while [[ -L "$source_path" ]]; do
        source_dir="$(cd -P -- "$(dirname -- "$source_path")" && pwd)"
        target="$(readlink "$source_path")"
        if [[ "$target" = /* ]]; then
            source_path="$target"
        else
            source_path="$source_dir/$target"
        fi
    done

    cd -P -- "$(dirname -- "$source_path")" && pwd
}

backend="${AI_COMMIT_BACKEND:-pi}"
model="${AI_COMMIT_MODEL:-}"

git rev-parse --is-inside-work-tree >/dev/null 2>&1 ||
    fail "not inside a Git working tree"

if [[ -z "$(git status --porcelain --untracked-files=normal)" && "$#" -eq 0 ]]; then
    fail "no changes to commit"
fi

guidance="${*:-No additional guidance.}"
IFS= read -r -d '' opencode_config <<'JSON' || true
{
  "permission": {
    "*": "deny",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "head": "allow",
    "echo": "allow",
    "bash": {
      "*": "deny",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git add *": "allow",
      "git commit -m *": "allow",
      "git commit --amend -m *": "allow",
      "git add *--force*": "deny",
      "git add -f*": "deny",
      "git add * -f*": "deny",
      "git commit *--no-verify*": "deny",
      "git commit -n*": "deny",
      "git commit * -n*": "deny"
    }
  }
}
JSON

IFS= read -r -d '' prompt <<PROMPT || true
Create or amend one Git commit as requested.

Requirements:
- Inspect the status, diff, and recent Git history.
- Match the repository's commit message convention.
- Prefer a single-line subject with no body unless repository convention or guidance calls for one.
- Amend only when explicitly requested. Otherwise create exactly one new commit.
- Run normal Git hooks.
- Stop and warn instead of committing suspected credentials, secrets, or sensitive data.
- If a safe commit cannot be made, stop and explain why.

Additional guidance: $guidance
PROMPT

case "$backend" in
    pi)
        pi_bin="${AI_COMMIT_PI_BIN:-pi}"
        command -v "$pi_bin" >/dev/null 2>&1 ||
            fail "Pi is not installed or not on PATH"
        script_dir="$(resolve_script_dir)"
        pi_extension="${AI_COMMIT_PI_EXTENSION:-$script_dir/../lib/ai-git/pi-git-tools.js}"
        [[ -r "$pi_extension" ]] ||
            fail "Pi Git tools extension not found: $pi_extension"
        AI_GIT_PI_MODE=commit command "$pi_bin" \
            --print \
            --no-session \
            --no-extensions \
            --no-skills \
            --no-prompt-templates \
            --no-context-files \
            --no-approve \
            --tools read,grep,find,ls,git_status,git_diff,git_log,git_add,git_commit \
            --extension "$pi_extension" \
            --model "${model:-openai-codex/gpt-5.6-luna}" \
            "$prompt"
        ;;
    opencode)
        opencode_bin="${AI_COMMIT_OPENCODE_BIN:-opencode}"
        command -v "$opencode_bin" >/dev/null 2>&1 ||
            fail "OpenCode is not installed or not on PATH"
        OPENCODE_CONFIG_CONTENT="$opencode_config" \
            command "$opencode_bin" run --model "${model:-deepseek/deepseek-v4-flash}" "$prompt"
        ;;
    *)
        fail "unsupported backend: $backend"
        ;;
esac
